{
  "name": "call-recorder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "kill-port": "lsof -ti:1420 | xargs kill -9 2>/dev/null || true",
    "dev": "npm run kill-port && vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "emulators": "firebase emulators:start",
    "clean": "rm -rf ~/Library/WebKit/dk.holion.call-recorder ~/Library/Application\\ Support/dk.holion.call-recorder/WebKit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "firebase": "^12.11.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
