{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Call Recorder",
  "version": "0.1.0",
  "identifier": "dk.holion.call-recorder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Call Recorder",
        "width": 900,
        "height": 650,
        "visible": false,
        "center": true,
        "resizable": true,
        "minWidth": 700,
        "minHeight": 500
      },
      {
        "label": "anna-panel",
        "url": "anna.html",
        "title": "Anna",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://accounts.google.com wss://*.firebaseio.com http://127.0.0.1:9099 http://127.0.0.1:8083; img-src 'self' https://*.googleusercontent.com; frame-src 'self' https://accounts.google.com https://*.firebaseapp.com",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
